{

	"name": "note-tidy",

	"version": "1.3.8",

	"description": "Obsidian plugin: imports external-path images, renames garbled image files, and typesets note text (spacing, punctuation, formulas, tags, chat logs).",

	"main": "main.js",

	"author": "KahoTAT",

	"type": "module",

	"scripts": {

		"dev": "node esbuild.config.mjs",

		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",

		"deploy": "node deploy.mjs",

		"test": "node test/run-tests.mjs",

		"version": "node version-bump.mjs && git add manifest.json versions.json",

		"lint": "eslint ."

	},

	"keywords": [],

	"license": "0-BSD",

	"devDependencies": {

		"@eslint/js": "9.30.1",

		"@types/node": "^16.18.126",

		"esbuild": "0.25.5",

		"eslint-plugin-obsidianmd": "0.4.2",

		"globals": "14.0.0",

		"jiti": "2.6.1",

		"tslib": "2.4.0",

		"typescript": "^5.8.3",

		"typescript-eslint": "8.35.1"

	},

	"dependencies": {

		"obsidian": "1.13.1"

	}

}

